; Test while with simulated continue

(var i 0)
(var sum 0)
(var __continue false)

(while (< i 10)
  (block
    (set __continue false)
    (set i (+ i 1))
    (if (= (% i 2) 0)
      (set __continue true)
      nil)
    (if (not __continue)
      (set sum (+ sum i))
      nil)))

sum

; Expect: 25
